# Copy this file to one named exactly  .env  (starts with a dot) in the same
# folder, then replace every REPLACE_ME. The .env file is where the bridge
# reads its settings and passwords from; it stays on this computer only and
# is never uploaded to GitHub (.gitignore blocks it).
#
# Every value marked REPLACE_ME is also listed in NEXT.md with an explanation.

# ---- Mode switches ------------------------------------------------------
# The defaults below are the safe "offline" ones: the bridge runs entirely on
# built-in sample data, talks to no websites, and writes emails to the
# outbox/ folder instead of sending them.

# Where sensor data comes from: fixture (built-in sample data), browser (log
# into the real IrroCloud website), or api (waiting on Irrometer's API docs).
FETCHER=fixture

# offline = pretend Helios answers (for testing); live = the real Helios service.
HELIOS_MODE=offline

# file = write emails into the outbox/ folder; smtp = actually send them.
NOTIFY_MODE=file

# false = every email meant for Jacob goes to Henry instead, with
# "[DRY RUN → Jacob]" in the subject. Change to true only when Jacob's
# written OK for automated access is in hand. This is THE switch the README
# talks about.
SEND_TO_JACOB=false

# ---- IrroCloud (Irrometer's soil-sensor website) ------------------------
IRROCLOUD_URL=https://www.irrocloud.com
IRROCLOUD_EMAIL=REPLACE_ME
IRROCLOUD_PASSWORD=REPLACE_ME

# ---- Helios (Irrigant's forecast service) -------------------------------
# The web address of the Helios app, for example https://helios.up.railway.app
HELIOS_URL=REPLACE_ME
# Jacob's Helios login (the bridge saves runs into HIS history).
HELIOS_EMAIL=REPLACE_ME
HELIOS_PASSWORD=REPLACE_ME

# ---- Email sending ------------------------------------------------------
# The bridge sends mail through Gmail. SMTP is just the name of the system
# email programs use to send mail; these two lines rarely change.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# The Gmail address the bridge sends FROM.
SMTP_USER=REPLACE_ME
# A 16-character "app password" Google creates for programs like this one —
# NOT the normal Gmail password. NEXT.md has the click-by-click path.
SMTP_PASSWORD=REPLACE_ME

# ---- People -------------------------------------------------------------
HENRY_EMAIL=REPLACE_ME
JACOB_EMAIL=REPLACE_ME
# Shown at the bottom of Jacob's email so he can call or text.
HENRY_PHONE=REPLACE_ME

# ---- Rarely changed -----------------------------------------------------
# The clock the emails and charts use. Boise time.
TIMEZONE=America/Boise
